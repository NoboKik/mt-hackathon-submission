# Copy to infra/.env (gitignored; on the server `chmod 600`). docker compose reads it from here.
# Every value may stay empty locally: you get http://localhost, dev credentials, an open demo.

# Postgres. On the server: `openssl rand -hex 24` — it goes into DATABASE_URL unescaped, so no
# @ / : #. The port is bound to 127.0.0.1 only.
POSTGRES_USER=provodnik
POSTGRES_PASSWORD=
POSTGRES_DB=provodnik

# Signs the session cookie. Optional: empty → a random key generated on the first boot and kept
# in the `secrets` volume. Set one (`openssl rand -hex 32`) only to pin it yourself.
AUTH_SECRET=

# Caddy's site address. Empty → :80 (plain HTTP, local). On the server: the bare domain, e.g.
# p400.example.ru — Caddy then fetches a Let's Encrypt certificate by itself.
SITE_ADDRESS=

# 1: the first boot adds the demo user and 35 leaderboard colleagues (a demo stand).
# 0: a real install — no demo people, ever; create accounts with `pnpm user:add` (see README).
SEED_DEMO=1

# Demo login invite code: demo visitors get /login?invite=<code>. Empty → anyone can use the demo
# login. Generate with `openssl rand -hex 8`.
DEMO_INVITE=

# Auto mode's generator: any OpenAI-compatible /chat/completions endpoint. Empty → the app
# runs and /auto says it isn't configured.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: sent as reasoning_effort only when set (e.g. `low`).
LLM_REASONING_EFFORT=
# Players' generations per rolling 24 h. Empty → 100; 0 → none.
LLM_DAILY_LIMIT=100
