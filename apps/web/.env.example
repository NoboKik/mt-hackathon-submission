# Copy to apps/web/.env — read by `pnpm dev` (Next), `pnpm db:migrate` (drizzle-kit) and `pnpm db:seed`.
# Matches the dev Postgres from infra/docker-compose.yml (published on 127.0.0.1:5432).
DATABASE_URL=postgres://provodnik:provodnik@localhost:5432/provodnik

# Signing key for the p400_session cookie. Dev falls back to a fixed string; production must set
# a real one: `openssl rand -hex 32`.
AUTH_SECRET=
