# Copy to apps/web/.env — read by `pnpm dev` (Next), `pnpm db:migrate` (drizzle-kit) and `pnpm db:seed`.
# Matches the dev Postgres from infra/docker-compose.yml (published on 127.0.0.1:5432).
DATABASE_URL=postgres://provodnik:provodnik@localhost:5432/provodnik

# Signing key for the p400_session cookie. Dev falls back to a fixed string; production must set
# a real one: `openssl rand -hex 32`.
AUTH_SECRET=

# Auto mode's scenario generator: any OpenAI-compatible /chat/completions endpoint, e.g.
# https://openrouter.ai/api/v1 + deepseek/deepseek-v4.1-flash, or https://api.deepseek.com.
# Empty is fine: the app boots and only POST /api/auto answers that it isn't configured.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: sent as reasoning_effort only when set. `low` suits DeepSeek flash; leave it empty
# for a model that rejects the parameter.
LLM_REASONING_EFFORT=
